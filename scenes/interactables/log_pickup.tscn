[gd_scene load_steps=4 format=3 uid="uid://log_pickup_scene"]

[ext_resource type="Script" path="res://scripts/interactables/log_pickup.gd" id="1_log_pickup"]

[sub_resource type="BoxShape3D" id="BoxShape3D_datapad"]
size = Vector3(0.2, 0.02, 0.3)

[sub_resource type="StandardMaterial3D" id="Material_datapad"]
albedo_color = Color(0.05, 0.05, 0.07, 1)
emission_enabled = true
emission = Color(0.0, 0.2, 0.15, 1)
emission_energy_multiplier = 0.8
