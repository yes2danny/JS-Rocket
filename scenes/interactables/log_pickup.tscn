; =================================================================
; LOG PICKUP — How to plug in your own datapad model:
;   1. Delete the children of "PlaceholderModel"
;   2. Drag your .glb/.tscn model as a child of PlaceholderModel
;   3. Resize CollisionShape3D to match your model's bounds
;   The script sets visible=false on the root when picked up — your
;   model will disappear automatically. No code changes needed.
; =================================================================

[node name="LogPickup" type="StaticBody3D"]
script = ExtResource("1_log_pickup")
interaction_prompt = "Pick Up Datapad"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_datapad")

[node name="PlaceholderModel" type="Node3D" parent="."]

[node name="DatapadMesh" type="CSGBox3D" parent="PlaceholderModel"]
size = Vector3(0.2, 0.02, 0.3)
material = SubResource("Material_datapad")
