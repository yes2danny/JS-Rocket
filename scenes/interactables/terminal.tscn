[gd_scene load_steps=5 format=3 uid="uid://terminal_scene"]

[ext_resource type="Script" path="res://scripts/interactables/terminal.gd" id="1_terminal"]

[sub_resource type="BoxShape3D" id="BoxShape3D_terminal"]
size = Vector3(0.8, 0.6, 0.4)

[sub_resource type="StandardMaterial3D" id="Material_terminal_body"]
albedo_color = Color(0.08, 0.08, 0.1, 1)
metallic = 0.7
roughness = 0.6

[sub_resource type="StandardMaterial3D" id="Material_terminal_screen"]
albedo_color = Color(0.0, 0.15, 0.1, 1)
emission_enabled = true
emission = Color(0.0, 0.4, 0.25, 1)
emission_energy_multiplier = 1.5

; =================================================================
; TERMINAL — How to plug in your own PC model:
;   1. Delete the children of "PlaceholderModel" (Body + Screen)
;   2. Drag your .glb/.tscn model as a child of PlaceholderModel
;   3. Resize CollisionShape3D to match your model's bounds
;   The script has ZERO references to visual nodes — it just works.
; =================================================================

[node name="Terminal" type="StaticBody3D"]
script = ExtResource("1_terminal")
interaction_prompt = "Read Terminal"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)
shape = SubResource("BoxShape3D_terminal")

[node name="PlaceholderModel" type="Node3D" parent="."]

[node name="Body" type="CSGBox3D" parent="PlaceholderModel"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)
size = Vector3(0.8, 0.6, 0.4)
material = SubResource("Material_terminal_body")

[node name="Screen" type="CSGBox3D" parent="PlaceholderModel"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.45, -0.18)
size = Vector3(0.6, 0.35, 0.05)
material = SubResource("Material_terminal_screen")
