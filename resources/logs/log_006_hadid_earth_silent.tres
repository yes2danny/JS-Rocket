[ext_resource type="Script" path="res://resources/log_entry.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
log_id = "log_006_hadid_earth_silent"
title = "Earth Silent"
author = "Hadid, R. — Station Commander"
date = "Station Day 874"
content = "Earth has not responded to hails in 72 hours. All channels silent. Relay stations at Proxima and Barnard's — also silent.

I've ordered Alcott to run full diagnostics on our comm array. He says it's functioning perfectly. We're transmitting. Nobody's answering.

I'm keeping this from the crew for now. Corvan is already on edge about his \"vanishing stars\" — and frankly, after looking at his data, so am I.

We are alone out here."
category = "late"
sort_order = 6
