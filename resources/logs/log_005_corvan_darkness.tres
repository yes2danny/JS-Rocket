[resource]
script = ExtResource("1_script")
log_id = "log_005_corvan_darkness"
title = "The Darkness"
author = "Corvan, J. — Stellar Observer"
date = "Station Day 869"
content = "Something is wrong with the survey.

Sector 7G-North — I'm showing ZERO stellar objects where last week there were 1,447. Not occulted. Not shifted. Gone. The background field in that region reads absolute black.

I've recalibrated three times. The instruments are fine.

The stars are vanishing.

I've informed Hadid. She thinks it's a sensor malfunction. It's not. I can see it with my own eyes from the observation deck. There's a patch of sky that's just... empty. And it's growing."
category = "middle"
sort_order = 5
