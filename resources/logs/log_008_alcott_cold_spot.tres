[resource]
script = ExtResource("1_script")
log_id = "log_008_alcott_cold_spot"
title = "Cold Spot"
author = "Alcott, M. — Engineer"
date = "Station Day 878"
content = "Found something I can't explain during exterior sensor check. Hull section 14-D, starboard observation deck wall, is reading -271.3 degrees Celsius. That's within two degrees of absolute zero.

Space is cold but not that cold. Our hull insulation should keep readings around -40C on exterior plates. Something is pulling the heat out of that section. Or something on the other side of that wall is very, very cold.

Corvan spends most of his time in the observation deck now. He doesn't blink enough."
category = "late"
sort_order = 8
